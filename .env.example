# Copy to .env and fill in. Never commit .env.
# This single file is read by the kin service (pydantic-settings) and passed to the Hermes
# container via docker-compose `env_file`. Hermes reads NEBIUS_API_KEY and TELEGRAM_* directly.

# --- Nebius Token Factory (required) ---
NEBIUS_API_KEY=
# No trailing slash: Hermes also reads this variable and appends paths to it.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Tavily (required for allow-listed lookups and the Tavily bonus) ---
TAVILY_API_KEY=

# --- Telegram (required for Kin D0+) ---
# @BotFather → /newbot → token. Then /mybots → Bot Settings → Group Privacy → Turn off,
# and remove + re-add the bot to the group afterwards (Telegram caches the setting).
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user ID (admin). Find it by messaging @userinfobot.
KIN_ADMIN_TELEGRAM_ID=
# Hermes gateway allow-lists (comma-separated numeric IDs). Group chat IDs start with -100.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_GROUP_ALLOWED_CHATS=
TELEGRAM_HOME_CHANNEL=

# --- Models (Token Factory IDs; `make models` verifies) ---
KIN_MODEL_OMNI=nvidia/Nemotron-3-Nano-Omni
KIN_MODEL_NANO=nvidia/Nemotron-3-Nano-30B-A3B
KIN_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
KIN_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
KIN_ULTRA_MAX_CALLS=2

# --- Kin service ---
KIN_DATA_DIR=./data
KIN_LOCALE=sg
KIN_POLICY_FILE=./config/policy.yaml
KIN_MCP_HOST=0.0.0.0
KIN_MCP_PORT=8765

# --- Hermes (container) ---
# Where the Hermes container keeps config.yaml, .env, state.db, memories, skills. Bind-mounted.
HERMES_HOME=/opt/data
