# Copy to .env and fill in. Never commit .env.
# This single file is read by the kin service (pydantic-settings) and passed to the Hermes
# container via docker-compose `env_file`. Hermes reads NEBIUS_API_KEY and TELEGRAM_* directly.

# --- Nebius Token Factory (required) ---
NEBIUS_API_KEY=
# No trailing slash: Hermes also reads this variable and appends paths to it.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Tavily (required for allow-listed lookups and the Tavily bonus) ---
TAVILY_API_KEY=

# --- Telegram (required for Kin D0+) ---
# @BotFather → /newbot → token. Then /mybots → Bot Settings → Group Privacy → Turn off,
# and remove + re-add the bot to the group afterwards (Telegram caches the setting).
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user ID (admin). Find it by messaging @userinfobot.
KIN_ADMIN_TELEGRAM_ID=
# Other roster members from config/members.yaml, as id:telegram_id (comma-separated).
# Unmapped members are roster-only; anyone else in the group gets default_role.
KIN_MEMBER_IDS=
# Hermes gateway allow-lists (comma-separated numeric IDs). Group chat IDs start with -100.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_GROUP_ALLOWED_CHATS=
TELEGRAM_HOME_CHANNEL=

# --- Judge demo (docs/07-demo-plan.md; synthetic fixture only, never a real family) ---
# KIN_DEMO=true: anyone may take the family's seats with /demo (KIN_ADMIN_TELEGRAM_ID and
# KIN_MEMBER_IDS are ignored) and reminders run on /demo monday instead of the clock.
# TELEGRAM_ALLOW_ALL_USERS=true lets Hermes pass strangers' DMs to Kin, which answers only
# /start, /help and /demo until they take a seat.
KIN_DEMO=false
TELEGRAM_ALLOW_ALL_USERS=false

# --- Models (Token Factory IDs; `make models` lists Nemotron and image-capable models) ---
# Photo/document extractor, chosen at D0. Nano Omni is dedicated-only on Token Factory, so a
# public image-capable model stands in (docs/05-architecture.md, Models). Nemotron Nano, Super
# and Ultra do classification and answers.
KIN_MODEL_VISION=openbmb/MiniCPM-V-4_5
KIN_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
KIN_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
KIN_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
KIN_ULTRA_MAX_CALLS=2

# --- Kin service ---
KIN_DATA_DIR=./data
KIN_LOCALE=sg
# Container timezone (both services); keep it equal to the locale pack's `timezone`.
TZ=Asia/Singapore
KIN_POLICY_FILE=./config/policy.yaml
# Loopback when kin runs on the host; compose sets 0.0.0.0 inside the container.
KIN_API_HOST=127.0.0.1
# Shared secret between the Kin plugin in Hermes and the kin API (`python -c "import secrets; print(secrets.token_urlsafe(32))"`).
KIN_API_TOKEN=
# Port when kin runs on the host; in compose kin listens on 8765 and is not published.
KIN_API_PORT=8765

# --- Hermes (container) ---
# Where the Hermes container keeps config.yaml, .env, state.db, memories, skills. Bind-mounted.
HERMES_HOME=/opt/data
